int fun1(unsigned word) {
    return (int) ((word << 24) >> 24);
}

a = 0x00000076
b = 0x87654321
c = 0x000000C6
d = 0xEDCBA987

fun1(a) =
(int) ((0x00000076 << 24) >> 24) =
(int) ((0x76000000) >> 24) =
(int) (0x00000076) =
0x00000076 =
7 * 16 + 6 = 118

fun2(a) =
((int) 0x00000076 << 24) >> 24 =
((int) 0x76000000) >> 24 =
7 < 8, therefore...
0x76000000 >> 24 =
0x00000076 =
7 * 16 + 6 = 118

fun1(b) =
(int) ((0x87654321 << 24) >> 24) =
(int) ((0x21000000) >> 24) =
(int) (0x00000021) =
0x00000021 =
2 * 16 + 1 = 33

fun2(b) =
((int) 0x87654321 << 24) >> 24 =
((int) 0x21000000) >> 24 =
2 < 8, therefore...
0x21000000 >> 24 =
0x00000021 =
2 * 16 + 1 = 33

fun1(c) =
(int) ((0x000000C9 << 24) >> 24) =
(int) ((0xC9000000) >> 24) =
(int) (0x000000C9) =
0x000000C9 =
12 * 16 + 9 = 201

fun2(c) =
((int) 0x000000C9 << 24) >> 24 =
((int) 0xC9000000) >> 24 =
C >= 8, therefore...
0xC9000000 >> 24 =
0xFFFFFFC9 =
-1 - 0x36 =
-1 - ( 3 * 16 + 6 ) =
-1 - 54 = -55

fun1(d) =
(int) ((0xEDCBA987 << 24) >> 24) =
(int) ((0x87000000) >> 24) =
(int) (0x00000087) =
0x00000087 =
8 * 16 + 7 = 135

fun2(d) =
((int) 0xEDCBA987 << 24) >> 24 =
((int) 0x87000000) >> 24 =
8 >= 8, therefore...
0x87000000 >> 24 =
0xFFFFFF87 =
-1 - 0x78 =
-1 - ( 7 * 16 + 8 ) =
-1 - 120 = -121